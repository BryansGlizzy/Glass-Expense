# ─────────────────────────────────────────────────────────────────────────────
# GlassExpense configuration. Copy to `.env` and fill in. NEVER commit `.env`.
# The server refuses to start in production if JWT_SECRET is missing or weak.
# ─────────────────────────────────────────────────────────────────────────────

# --- Required -----------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=
# Public origin of the app (used for email links, CORS, OAuth redirects)
APP_URL=http://localhost:3000

# --- Runtime ------------------------------------------------------------------
# Anything other than "development" runs in production mode (no Vite dev server).
# `npm run dev` sets NODE_ENV=development for you; `npm start` sets production.
# NODE_ENV=production
PORT=3000
# personal (default, single user unless a license is activated) | saas
MODE=personal
# Where the database, receipts and OTA bundles live. Default: ./data
# DATA_DIR=./data
# Number of reverse-proxy hops in front of the app (nginx/Cloudflare = 1). Needed for correct rate limiting.
TRUST_PROXY=1
# Extra allowed CORS origins, comma separated (the web app and Capacitor are already allowed)
# ALLOWED_ORIGINS=
# Session lifetime
# JWT_EXPIRES_IN=14d
# Roll the Content-Security-Policy out in report-only mode first if you add third-party assets
# CSP_MODE=report-only

# APP_URL: The URL where this applet is hosted.
APP_URL="https://example.com"

# --- End-to-end encryption -----------------------------------------------------
# Optional. Enables three OPT-IN features: "agent access" for API keys (read/write jobs and entries via /api/agent/v1; the server holds the
# keys of the jobs the user selects), "background Google Calendar sync" (the server holds the user's calendar key: job titles +
# dates only) and "reports with figures" (the server holds a report key that opens only a small aggregate summary). Each is sealed
# under this key. Without it, those opt-ins are simply unavailable and report e-mails contain counts only.
# Generate with: openssl rand -base64 32     (keep it secret; losing it disables those users' background sync)
# SERVER_WRAP_KEY=
# Minimum / default PBKDF2 iterations for account passwords (the app uses 600000).
# KDF_MIN_ITERATIONS=300000

# --- Admin --------------------------------------------------------------------
# The existing account with this email is promoted to admin on boot, and the address is reserved against registration by anyone
# else. Admin rights come only from the is_admin flag; to grant it later: npm run admin:promote -- <email>
ADMIN_EMAIL=
# Block public sign-ups once your account exists
# DISABLE_REGISTRATION=true

# --- Email (optional; when unset, outbound email is skipped) ---------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From address (defaults to SMTP_USER)
# EMAIL_FROM=

# --- Google Calendar sync (optional) --------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Push notifications (optional) ----------------------------------------------
# Path to a Firebase service-account JSON. Keep it OUTSIDE the repo or in ./secrets (gitignored).
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-adminsdk.json

# --- AI vision (BYOK) -------------------------------------------------------------
# Allow users to point the AI provider URL at private-network hosts such as a local Ollama (http://localhost:11434/v1).
# Leave false on any internet-facing deployment (SSRF protection).
# ALLOW_PRIVATE_AI_URLS=false
# Safer alternative for local models: list ONLY the endpoints (host or host:port, comma separated) that may use plain http and
# private addresses, for example your LAN model server. Everything else stays blocked.
# AI_ALLOWED_HOSTS=192.168.1.50:8000,localhost:11434
# Longest a single research/draft call may run, in milliseconds (default 600000 = 10 minutes, max 900000).
# AI_RESEARCH_TIMEOUT_MS=600000

# --- Invoices (e-mail) ------------------------------------------------------------
# Invoice e-mails use the SMTP settings above. Each user may send this many per day (a flat cap; there are no tier limits yet).
# INVOICE_EMAIL_DAILY_LIMIT=30
