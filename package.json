    "preview": "vite preview",
    "clean": "rm -rf dist public/vendor",
    "lint": "tsc --noEmit",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test": "bash scripts/test-e2e.sh"
  },
  "dependencies": {
