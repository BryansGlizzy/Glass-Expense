{
  "name": "glassexpense",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "dev:saas": "cross-env NODE_ENV=development MODE=saas tsx server/index.ts",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "serve": "npm run build && npm start",
    "assets:tesseract": "node scripts/copy-tesseract-assets.mjs",
